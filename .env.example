# Copie pra .env e preencha. (Pode tambem digitar direto na tela da demo.)

# Credenciais INMETRO da empresa (mesmo login do portal cronotacografo.rbmlq.gov.br)
INMETRO_USER=
INMETRO_PASSWORD=

# Chave da API do CapSolver (resolve o reCAPTCHA v2) — https://capsolver.com
CAPSOLVER_KEY=

# Proxy residencial BR (SOMENTE se rodar fora do Brasil, ex: Vercel).
# Use o MESMO valor que o sga-moss ja usa em producao. Formato:
# socks5://usuario:senha@host:porta
# Rodando local no seu PC (IP BR) nao precisa.
INMETRO_PROXY_URL=

# Porta do site (opcional, so no modo local)
PORT=3777
